{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "lib": ["ES2018"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./"]
    }
  },
  "include": ["../scripts/**/*.ts", "../lib/**/*.ts", "../types/**/*.ts"],
  "exclude": ["node_modules"]
}
